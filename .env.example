# Copy into the consuming project's .env — plan-rag reads these from the
# project root it is launched against, not from the plugin directory.

# Required: local BGE-M3 model directory (nothing is downloaded at runtime)
PLAN_RAG_EMBEDDING_BACKEND=flag_embedding
PLAN_RAG_EMBEDDING_MODEL_PATH=/path/to/local/bge-m3
PLAN_RAG_EMBEDDING_USE_FP16=true
# auto = cuda:0 when a GPU is free, otherwise cpu
PLAN_RAG_EMBEDDING_DEVICE=auto
# Optional: while the pid in this file is alive, auto keeps BGE-M3 on CPU so a
# local LLM keeps the GPU to itself
# LLAMA_PID_FILE=/path/to/llama.pid

# Corpus and index location, relative to this project
PLAN_RAG_DOCUMENT_ROOT=plan
PLAN_RAG_STATE_DIR=.plan-rag
PLAN_RAG_DEBOUNCE_SECONDS=2
